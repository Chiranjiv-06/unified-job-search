# ==============================================================================
# Unified Job Search & Application Management System - Environment Template
# Safe for version control. Do NOT commit production credentials or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
APP_NAME="Unified Job Search & Application Management System"
ENVIRONMENT=development    # Options: development | testing | production
DEBUG=True                 # Must be False in production

# ------------------------------------------------------------------------------
# 2. Server & Networking
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80"]

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure key with: openssl rand -hex 32
# In production, the system strictly refuses to start if this is default or < 32 characters.
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unified_job_search
POSTGRES_PORT=5432

# Database connection URL:
# For local development with custom local port:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:6314/unified_job_search
# For docker-compose deployment:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/unified_job_search

# ------------------------------------------------------------------------------
# 5. Redis & Celery Distributed Tasks
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# In docker-compose:
# REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 6. File Uploads (Resumes)
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 7. Optional Third-Party OAuth / Recruitment Ingestion
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email-accounts/oauth/callback
