# Application Configuration
APP_NAME="Unified Job Search & Application Management System"
ENVIRONMENT=development
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Note: In local development, check your PostgreSQL port (e.g., 5432 or 6314)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:6314/unified_job_search
# For testing or fallback:
# DATABASE_URL=sqlite:///./unified_job_search.db

# JWT Authentication
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Resume Storage
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE_MB=5

# Optional OAuth / Integrations (Phase 10)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email-accounts/oauth/callback
